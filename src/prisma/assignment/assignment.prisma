enum ExerciseCategoryType {
  python
  cpp    @map("c++")
  nodejs
  typeScript
  javaScript
  css
  less
  scss
  json
  html
  xml
  php
  csharp @map("c#")
  razor
  markdown
  java
  vb
  coffeescript
  batch
  pug
  fsharp @map("f#")
  lua
  powershell
  ruby
  r
  objectivec @map("objective-c")
}

model assessment {
  id                     Int                   @id @default(autoincrement())
  title                  String?
  description            String?
  input                  String?
  expected_output        String?
  max_score              Int?
  assessment_category_id Int?
  sub_id                 Int?

  category assessment_categories? @relation(fields: [assessment_category_id], references: [id])
}

model assessment_categories {
  id          Int                     @id @default(autoincrement())
  name        String                  @unique
  icon        String?
  sort_id     Int?
  type        ExerciseCategoryType?
  assessments assessment[]
}

model assessment_tests {
  id              Int     @id @default(autoincrement())
  assessment_id   Int?
  input           String?
  expected_output String?
  points          Int?
}

model submissions {
  id             Int       @id @default(autoincrement())
  user_id        Int?
  assessment_id  Int?
  submitted_code String?
  result         String?
  score          Int?
  submitted_at   DateTime? @default(now()) @db.Timestamp(0)
  graded_at      DateTime? @db.Timestamp(0)
  graded         Int?      @default(0)
  compile_res    String?
  test_res       String?
  test_error     String?
}